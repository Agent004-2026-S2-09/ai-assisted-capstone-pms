# Copy this file to .env and replace the placeholders with private values.
# Never put real credentials in this example file.

AGENTAUS_API_KEY=replace-with-your-api-key
API_ENDPOINT=https://your-agentaus-host/api/v1/chat/completions
ADMIN_PASSWORD=choose-a-local-administrator-password

# Optional processing and validation settings
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=500
OCR_PAGE_TIMEOUT_SECONDS=30
ENABLE_ANSWER_VALIDATION=true
